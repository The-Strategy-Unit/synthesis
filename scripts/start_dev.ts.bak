#!/usr/bin/env deno run --allow-all
/**
 * Cross-platform development start script with watch mode
 * Resolves correct paths for the current OS before launching the app
 */

import { config } from "../src/config.ts";

const vaultDir = config.vaultDir;
const port = config.port;

const os = Deno.build.os;
let tempDir: string;

switch (os) {
  case "windows":
    tempDir = Deno.env.get("TEMP") ?? Deno.env.get("TMP") ?? "C:\\temp";
    break;
  case "darwin":
    tempDir = "/tmp";
    break;
  case "linux":
    tempDir = "/tmp";
    break;
  default:
    tempDir = "/tmp";
}

const cmd = new Deno.Command(Deno.execPath(), {
  args: [
    "run",
    "--watch",
    "--allow-net",
    `--allow-read=web,${vaultDir},${tempDir}`,
    `--allow-write=${vaultDir},${tempDir}`,
    "--allow-run=yt-dlp",
    "--allow-env",
    "main.ts",
  ],
  stdin: "inherit",
  stdout: "inherit",
  stderr: "inherit",
});

// Start server process
const process = cmd.spawn();

// Try to open browser after server starts (fire-and-forget)
const url = `http://localhost:${port}`;
const opener = os === "windows"
  ? ["cmd", "/c", "start", url]
  : os === "darwin"
  ? ["open", url]
  : ["xdg-open", url];

// Run opener in background, don't wait for it
try {
  new Deno.Command(opener[0], { args: opener.slice(1), stdin: "null" }).spawn();
  console.log(`\nOpening browser: ${url}\n`);
} catch {
  console.log(`\nOpen browser to: ${url}\n`);
}

const status = await process.status;
Deno.exit(status.code);
