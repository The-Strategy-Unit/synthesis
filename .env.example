# Synthesis environment configuration
# All values have sensible defaults — only override what you need.

# --- Core ---
SYNTHESIS_VAULT="$HOME/Synthesis"
SYNTHESIS_HOST="127.0.0.1"
SYNTHESIS_PORT=8000
SYNTHESIS_OPEN_BROWSER=true

# --- Private beta security ---
# Enable only when the origin is reachable exclusively through the trusted
# identity proxy. The proxy must set Cf-Access-Authenticated-User-Email.
SYNTHESIS_TRUST_PROXY_AUTH=false
SYNTHESIS_PUBLIC_ORIGIN="https://synthesis.example.org"
SYNTHESIS_ALLOWED_EMAILS="viewer@example.org,ingester@example.org"
SYNTHESIS_INGESTER_EMAILS="ingester@example.org"
SYNTHESIS_MAX_BODY_BYTES=1048576
SYNTHESIS_MAX_UPLOAD_BYTES=26214400
SYNTHESIS_MAX_PASTED_TEXT_CHARS=250000
SYNTHESIS_MAX_TRANSCRIPT_CHARS=500000
SYNTHESIS_MAX_SUBTITLE_BYTES=10485760
SYNTHESIS_MAX_TITLE_CHARS=200
SYNTHESIS_MAX_SEARCH_CHARS=500
SYNTHESIS_MODEL_TIMEOUT_MS=600000
SYNTHESIS_YT_DLP_TIMEOUT_MS=120000
SYNTHESIS_INGEST_QUEUE_SIZE=4
SYNTHESIS_PER_USER_DAILY_JOBS=5
SYNTHESIS_GLOBAL_DAILY_JOBS=20
SYNTHESIS_SEMANTIC_SEARCHES_PER_MINUTE=5

# --- LLM API ---
SYNTHESIS_API_BASE="http://localhost:11434/v1"
SYNTHESIS_API_KEY="ollama"
SYNTHESIS_REASONING_EFFORT="none"
SYNTHESIS_LLM_TEMPERATURE=0.1
SYNTHESIS_EXTRACT_TEMPERATURE=0
SYNTHESIS_CONSOLIDATE_TEMPERATURE=0.1
SYNTHESIS_INTEGRATE_TEMPERATURE=0.1
SYNTHESIS_EXTRACT_MAX_TOKENS=2000
SYNTHESIS_CONSOLIDATE_MAX_TOKENS=4000
SYNTHESIS_INTEGRATE_MAX_TOKENS=2000
SYNTHESIS_REWRITE_MAX_TOKENS=2000
SYNTHESIS_MAX_TOKENS=800

# --- Model roles ---
# The quality floor uses the dense qwen3.8:27b model for every chat role.
# Override these explicitly when using another compatible provider model.
SYNTHESIS_EXTRACT_MODEL="qwen3.8:27b"
SYNTHESIS_CONSOLIDATE_MODEL="qwen3.8:27b"
SYNTHESIS_INTEGRATE_MODEL="qwen3.8:27b"
SYNTHESIS_REWRITE_MODEL="qwen3.8:27b"

# --- Embeddings ---
SYNTHESIS_EMBED_MODEL="nomic-embed-text-v2-moe:latest"
SYNTHESIS_EMBED_DIMENSIONS=768

# --- Ingest ---
SYNTHESIS_MAX_CHARS=12000
SYNTHESIS_CHUNK_OVERLAP=500
SYNTHESIS_YT_DLP_PATH="yt-dlp"
SYNTHESIS_SUBTITLES_LANG="en"
SYNTHESIS_PLAYLIST_ENABLED=true
SYNTHESIS_MAX_PLAYLIST_ITEMS=10
SYNTHESIS_MAX_PDF_PAGES=500
SYNTHESIS_PDF_PARSE_TIMEOUT_MS=30000
# Maximum exact YouTube videos in one explicitly confirmed automatic batch.
SYNTHESIS_MAX_TRUSTED_BATCH_ITEMS=100

# --- Linking ---
# Retain each page's strongest cross-source semantic neighbours in the derived
# graph, and show this many per page initially.
SYNTHESIS_LINK_K=8
SYNTHESIS_GRAPH_NEIGHBORS=3
# Switch from spacious overview labels to tighter detail labels at this zoom.
# Titles remain visible below the threshold wherever space allows.
SYNTHESIS_LABEL_ZOOM_THRESHOLD=1.5

# --- Search ---
SYNTHESIS_SEARCH_LIMIT=20
