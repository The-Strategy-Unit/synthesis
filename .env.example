# Synthesis environment configuration
# All values have sensible defaults — only override what you need.

# --- Core ---
SYNTHESIS_VAULT="$HOME/Synthesis"
SYNTHESIS_PORT=8000

# --- LLM API ---
SYNTHESIS_API_BASE="http://localhost:11434/v1"
SYNTHESIS_API_KEY="ollama"
SYNTHESIS_REASONING_EFFORT="none"

# --- Model roles ---
SYNTHESIS_EXTRACT_MODEL="qwen3.5:9b"
SYNTHESIS_CONSOLIDATE_MODEL="qwen3.6:27b"
SYNTHESIS_INTEGRATE_MODEL="qwen3.5:9b"
SYNTHESIS_REWRITE_MODEL="qwen3.6:27b"

# --- Embeddings ---
SYNTHESIS_EMBED_MODEL="qwen3-embedding:8b"
SYNTHESIS_EMBED_DIMENSIONS=4096

# --- Ingest ---
SYNTHESIS_MAX_CHARS=12000
SYNTHESIS_CHUNK_OVERLAP=500
SYNTHESIS_SUBTITLES_LANG="en"

# --- Linking ---
SYNTHESIS_LINK_THRESHOLD=0.75
SYNTHESIS_LINK_K=50

# --- Search ---
SYNTHESIS_SEARCH_LIMIT=20

