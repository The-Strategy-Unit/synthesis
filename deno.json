{
  "name": "synthesis",
  "version": "0.1.0",
  "tasks": {
    "setup": "deno run --allow-all scripts/setup.ts",
    "migrate": "deno run --allow-all scripts/migrate.ts",
    "dev": "SYNTHESIS_WATCH=true deno task start",
    "lint": "deno lint --fix && deno fmt",
    "start": "deno run --allow-all scripts/start.ts",
    "build": "deno run --allow-all scripts/build.ts",
    "yt-dlp": "deno run --allow-all scripts/fetch_yt_dlp.ts",
    "test": "deno run --allow-all scripts/test.ts"
  },
  "imports": {
    "d3-force": "https://esm.sh/d3-force@3",
    "d3-selection": "https://esm.sh/d3-selection@3",
    "d3-drag": "https://esm.sh/d3-drag@3",
    "sqlite-vec": "npm:sqlite-vec@^0.1.9"
  },
  "exports": "./main.ts",
  "exclude": ["web/", "dist/"]
}
